/* ============================================================
   Censos Bolivia — Compatible con modo claro y oscuro de QGIS
   Solo estilos estructurales; colores heredados del tema del sistema.
   ============================================================ */

QGroupBox {
    border: 1px solid palette(mid);
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
    font-size: 11px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

QComboBox {
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    min-height: 22px;
}

QComboBox:focus {
    border: 2px solid palette(highlight);
    padding: 3px 7px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QLabel {
    font-size: 11px;
}

QLabel#lbl_hint {
    font-size: 10px;
    font-style: italic;
}

QLabel#lbl_stat_value {
    font-weight: bold;
    font-size: 12px;
}

QLabel#lbl_section {
    font-weight: bold;
    font-size: 10px;
    letter-spacing: 1px;
}

QLabel#lbl_var_desc {
    font-size: 10px;
    font-style: italic;
}

/* Título del resumen: qué se está mapeando. Es el dato más importante del
   bloque, así que va por encima de los encabezados de sección. */
QLabel#lbl_result_title {
    font-size: 12px;
    font-weight: bold;
    padding: 2px 0 4px 0;
}

/* Aviso junto al selector de agregación (tipo desconocido, sin categorías). */
QLabel#lbl_aviso {
    font-size: 10px;
    font-style: italic;
    color: palette(highlight);
}

QProgressBar#progress_descarga {
    border: 1px solid palette(mid);
    border-radius: 4px;
    text-align: center;
    font-size: 10px;
    max-height: 14px;
}

QProgressBar#progress_descarga::chunk {
    background-color: palette(highlight);
    border-radius: 3px;
}

QProgressBar#stat_bar {
    border: none;
    border-radius: 2px;
    background-color: palette(midlight);
    text-align: center;
    font-size: 9px;
    max-height: 14px;
}

QProgressBar#stat_bar::chunk {
    background-color: palette(highlight);
    border-radius: 2px;
}

/* ── Los dos pasos ────────────────────────────────────────────────────────────
   Misma forma y mismo tamaño: son dos pasos del mismo flujo, no una acción
   principal y otra secundaria. El que toca pulsar lleva `paso_activo=true` y va
   relleno; el otro queda delineado. El panel mueve el énfasis de 1 a 2 en cuanto
   la consulta devuelve resultado (_update_button_emphasis).
   ------------------------------------------------------------------------- */

QPushButton#btn_paso {
    border-radius: 5px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: bold;
    min-height: 32px;
}

/* Paso que toca ahora: relleno */
QPushButton#btn_paso[paso_activo="true"] {
    background-color: #1a3a5c;
    color: #ffffff;
    border: 1px solid #1a3a5c;
}

QPushButton#btn_paso[paso_activo="true"]:hover {
    background-color: #2a5a8c;
    border-color: #2a5a8c;
}

QPushButton#btn_paso[paso_activo="true"]:pressed {
    background-color: #0f2540;
}

/* Paso que ya no es el foco: delineado, mismo tamaño */
QPushButton#btn_paso[paso_activo="false"] {
    background-color: transparent;
    border: 1px solid palette(mid);
    color: palette(text);
}

QPushButton#btn_paso[paso_activo="false"]:hover {
    border-color: palette(highlight);
    background-color: palette(midlight);
}

/* Deshabilitado: se lee como "todavía no", sin llamar la atención */
QPushButton#btn_paso:disabled {
    background-color: transparent;
    border: 1px dashed palette(mid);
    color: palette(mid);
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: palette(mid);
}

QPlainTextEdit {
    border: 1px solid palette(mid);
    border-radius: 4px;
    font-size: 11px;
    font-family: monospace;
}

QPlainTextEdit:focus {
    border: 2px solid palette(highlight);
}
